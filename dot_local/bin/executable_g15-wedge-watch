#!/bin/bash
# Probe the AW-ELC LED controller for the wedge (echo-ack) state.
# Logs only transitions; on OK->WEDGED saves a journal snapshot and notifies.
LOG=~/.local/state/g15-wedge-watch.log
LAST=~/.local/state/g15-wedge-watch.last
mkdir -p ~/.local/state

B=$(awk -F= '$1=="brightness"{print $2}' ~/.config/g15/state 2>/dev/null)
probe() { out=$(/home/andeen/.cargo/bin/g15 led brightness "${B:-100}" 2>&1); }
if probe; then
	now=OK
elif [[ $out == *wedged* ]]; then
	# a concurrent g15 command can leave a foreign ack in the buffer and fake
	# the echo signature — a real wedge persists, so confirm before alerting
	sleep 3
	if probe; then
		now=OK
	elif [[ $out == *wedged* ]]; then
		now=WEDGED
	else
		now=ERROR
	fi
else
	now=ERROR # hidraw missing, permission, etc — not the wedge signature
fi

last=$(cat "$LAST" 2>/dev/null)
echo "$now" >"$LAST"
[[ $now == "$last" ]] && exit 0

echo "$(date -Is) ${last:-first-run} -> $now ${out:+| $out}" >>"$LOG"

if [[ $now == WEDGED ]]; then
	snap=~/.local/state/g15-wedge-journal-$(date +%Y%m%d-%H%M%S).txt
	{
		echo "== g15 state =="
		cat ~/.config/g15/state 2>/dev/null
		echo "== journal, last 15 min =="
		journalctl --since '-15 min' --no-pager
	} >"$snap" 2>&1
	notify-send -u critical -a g15 "LED controller WEDGED" \
		"Detected $(date +%H:%M:%S). Snapshot: $snap — note what you were just doing!"
fi
